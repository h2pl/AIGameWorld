// ============================================================
// AIGameWorld Frontend / Frontend Package Config
// ============================================================
{
  "name": "AIGameWorld-frontend",         // Package name
  "version": "0.1.0",                      // Version
  "type": "module",                        // ES Module mode
  "engines": { "node": ">=20" },           // Min Node.js version
  "scripts": {
    "dev": "vite --port 3000",             // Start dev server
    "build": "tsc && vite build",          // Build production
    "preview": "vite preview",             // Preview build
    "test": "vitest run",                  // Run tests
    "test:watch": "vitest",                // Watch mode
    "lint": "eslint src/",                 // Lint
    "format": "prettier --write src/"      // Format
  },
  "dependencies": {
    "phaser": "^3.80.0"                   // Phaser 3 engine
  },
  "devDependencies": {
    "typescript": "^5.4.0",                // TypeScript
    "vite": "^5.0.0",                      // Vite
    "vitest": "^1.0.0",                    // Vitest
    "eslint": "^9.0.0",                    // ESLint
    "prettier": "^3.0.0"                   // Prettier
  }
}
