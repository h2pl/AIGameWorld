# AIGameWorld 环境变量 / Environment Variables
# 复制为 .env 后填入实际值 / Copy to .env and fill in values

# Zen Proxy（端口 6446，无需真实 key，任意值即可）
# DEEPSEEK_API_KEY=          # 填入你的 DeepSeek API Key
# GLM_API_KEY=              # 智谱 GLM-5.2
# ANTHROPIC_API_KEY=        # Claude 降级

# Langfuse 可观测性 (可选 / Optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# LangSmith 开发期调试与评估 (可选 / Optional)
# LangSmith 与 LangGraph 原生集成，设置环境变量即可启用
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aigameworld
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
