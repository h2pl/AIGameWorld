# Server
HOST=0.0.0.0
PORT=8000

# LLM - Primary (DeepSeek)
DEEPSEEK_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1

# LLM - Fallback (Anthropic Claude)
ANTHROPIC_API_KEY=your_key_here

# Observability - Langfuse (可选，留空则禁用追踪)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Database
SQLITE_PATH=data/world.db
CHROMA_PATH=data/chroma/

# World Pack
DEFAULT_PACK=forgotten_realms

# Auto Run
AUTO_INTERVAL_MS=2000

# Logging
LOG_LEVEL=INFO
