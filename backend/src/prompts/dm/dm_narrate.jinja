{# Phase 6: DM 叙事渲染 #}
{% include '_persona_dm.jinja' %}

{# === CONTEXT: 上下文注入 === #}
剧情梗概：{{ plot_brief }}

角色行动：
{% for action in character_actions %}
- {{ action.get("character_id", "?") }} ({{ action.get("type", "?") }}): {{ action.get("description", "") }}
{% else %}
- 无角色行动
{% endfor %}

{% if events %}
发生的事件：
{% for ev in events %}- {{ ev.get("description", ev) }}
{% endfor %}
{% endif %}

{% if combat_result %}
战斗结果：{{ combat_result }}
{% endif %}

{# === OUTPUT: 输出格式约束 === #}
请用中文叙事，输出 JSON：
{
  "narrative": "中文故事文本（3-5句，第三人称 DND DM 口吻）",
  "branch_points": [{"decision_maker": "pc_id", "decision": "...", "consequence": "..."}],
  "hooks_resolved": ["hook_id", ...]
}
