{# Phase 1: DM 创造情境 #}
{% include '_persona_dm.jinja' %}

{# === CONTEXT: 上下文注入 === #}
{% if story_arcs %}
当前剧情线：
{% for arc in story_arcs %}
- {{ arc.title }}（{{ arc.stage }}）
{% endfor %}
{% endif %}

{% if active_hooks %}
已埋下的伏笔（未回收）：
{% for hook in active_hooks %}
- {{ hook.description }}
{% endfor %}
{% endif %}

{% if recent_summary %}
最近事件摘要：{{ recent_summary }}
{% endif %}

{% if plot_brief_prev %}
上一步剧情：{{ plot_brief_prev }}
{% endif %}

{% if pacing %}
节奏感知：距离上次大事件 {{ pacing.ticks_since_last_event }} 步
{% if pacing.needs_conflict %}（需要注入冲突）{% endif %}
{% endif %}

{# === OUTPUT: 输出格式约束 === #}
创造情境输出 JSON：
{
  "instructions": ["玩家可以做什么的建议（中文句子）", "..."],
  "plot_brief": "本步剧情梗概（2-3句，角色行动前发生的事）",
  "scene_direction": {
    "featured_pcs": ["pc_id", ...],
    "featured_actors": ["actor_id", ...],
    "actor_motivations": {"actor_id": "动机描述"}
  }
}
