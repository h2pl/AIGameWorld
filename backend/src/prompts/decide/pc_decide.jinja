{
  "action": {
    "action_type": "talk",
    "target_id": "pc_cleric",
    "target_type": "pc",
    "explore_x": null,
    "explore_y": null,
    "thought": "前方地窖门半掩着，里面可能有陷阱。队伍里的牧师有侦测魔法的能力，先和他商量一下进去后的分工——我打头阵，他在后面支援和治疗。"
  }
}
