{
  "world": {
    "id": "starraft",
    "name": "星槎大陆",
    "description": "《星槎大陆》是一片漂浮于云海之上的奇幻陆地，七种元素律动交织成「七律共鸣」之力，维系着天地的平衡。大陆由数座自治城邦组成：自由之风眷顾的「风歌城」、契约与岩魂铸就的「岩港」、雷云封锁的「沉潮神殿」以及暗影滋生的「走私者石窟」。一位跨越世界壁垒的「异界来客」降临此地，在七位「律执政」的注视下，揭开千年前「原初星陨」的真相，并平息因共鸣失衡而蔓延的异变。星槎会（冒险者公会）与暗影教团（信奉吞噬共鸣的异教）的对立贯穿始终；岩港的万契堂以黄金契约维系秩序，沉潮神殿中潮之律沉睡，等待纯净共鸣者唤醒。",
    "version": "1.0.0",
    "rule_set": "sept_resonance",
    "author": "skill-world-builder",
    "starting_scene_id": "starraft_windsgate",
    "status": "init",
    "data_tick": 0,
    "display_tick": 0
  },
  "scenes": [
    {
      "id": "starraft_windsgate",
      "name": "风歌城",
      "type": "town",
      "description": "风歌城是星槎大陆最自由的城邦，高耸的风车与飘扬的旗帜在云风中转动，城民信奉「风之律」带来的无拘与欢颂。星槎会总部坐落于此，大广场的七律祭坛是旅者接取委托之处。城西集市喧闹，城东钟楼可俯瞰云海。",
      "spawn_x": 9,
      "spawn_y": 38,
      "map_width": 50,
      "map_height": 50,
      "world_id": "starraft",
      "tilemap_summary": "{\"id\":\"starraft_windsgate\",\"type\":\"town\",\"full_interpretation\":\"风歌城，自由城邦，云风环绕，星槎会总部与七律祭坛，旅者启程与接取委托之地；含城西集市、城东钟楼。\"}",
      "ext_json": "{\"tile_size\":16,\"tilemap_url\":\"assets/tuxemon/maps/azure_town.json\",\"tilesets\":[{\"name\":\"core_outdoor\",\"url\":\"assets/tuxemon/gfx/tilesets/core_outdoor.png\"}]}"
    },
    {
      "id": "starraft_rockhaven",
      "name": "岩港",
      "type": "town",
      "description": "岩港依山而建，以「岩之律」的稳固与契约精神立城，码头停泊着来往各城邦的商船。岩之执政端坐于「万契堂」中裁决争端，城中遍布石刻契约与黄金市集，地下则是走私者石窟的隐秘入口。",
      "spawn_x": 20,
      "spawn_y": 30,
      "map_width": 64,
      "map_height": 60,
      "world_id": "starraft",
      "tilemap_summary": "{\"id\":\"starraft_rockhaven\",\"type\":\"town\",\"full_interpretation\":\"岩港，契约之城，岩之律稳固，万契堂与黄金市集，商船往来；地下藏走私者石窟入口。\"}",
      "ext_json": "{\"tile_size\":16,\"tilemap_url\":\"assets/tuxemon/maps/taba_town.json\",\"tilesets\":[{\"name\":\"core_outdoor\",\"url\":\"assets/tuxemon/gfx/tilesets/core_outdoor.png\"}]}"
    },
    {
      "id": "starraft_sunkenhall",
      "name": "沉潮神殿",
      "type": "outdoor",
      "description": "沉潮神殿坐落于雷云笼罩的水域深处，传说「潮之律」在此沉睡。神殿水道纵横，雷光在水面跳跃，唯有共鸣纯净者方能踏入核心，聆听远古潮声并唤醒沉睡的律之执政。",
      "spawn_x": 25,
      "spawn_y": 30,
      "map_width": 50,
      "map_height": 60,
      "world_id": "starraft",
      "tilemap_summary": "{\"id\":\"starraft_sunkenhall\",\"type\":\"outdoor\",\"full_interpretation\":\"沉潮神殿，雷云水域，潮之律沉睡，水道纵横，雷光跳跃，唤醒执政之地。\"}",
