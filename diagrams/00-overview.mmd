%% SimGameWorld 总体架构图 / Overall Architecture
%% 六层架构 / Six-layer architecture

graph TB
    subgraph UI["🎮 UI 层 / UI Layer — Phaser 3 + DOM 面板"]
        UI1["瓦片地图 / Tilemap"]
        UI2["角色精灵 (PC/Actor) / Character Sprites"]
        UI3["场景对象 / SceneObjects"]
        UI4["事件日志 / EventLog"]
        UI5["角色面板 / Inspector"]
    end

    subgraph API["🌐 API 层 / API Layer — FastAPI + WebSocket"]
        API1["/health 健康检查"]
        API2["/ws WebSocket"]
        API3["TickController 节奏控制"]
        API4["错误降级 / Error Fallback"]
    end

    subgraph ORCH["⚙️ 编排层 / Orchestration — LangGraph TickGraph"]
        direction TB
        P1["Phase 1: DM 创造情境 / Create Situation"]
        P2["Phase 2: WorldEngine 执行 / Execute"]
        P3["Phase 3: PC/Actor 并行决策 / Decide"]
        P4["Phase 4: Engine 裁决 / Resolve"]
        P5["Phase 5: 状态更新 / State Update"]
        P6["Phase 6: DM 叙事渲染 / Narrate"]
        P7["Phase 7: 反思+摘要 / Reflect+Summarize"]
        P1 --> P2 --> P3 --> P4 --> P5 --> P6 --> P7
    end

    subgraph AGENT["🧠 Agent 层 / Agent Layer — LLM 驱动"]
        A1["DM Agent（情境创造者）"]
        A2["PC Agent ×4（主角团决策）"]
        A3["Actor Agent ×N（配角响应）"]
        A4["记忆系统 / Memory System"]
        A5["RAG 系统 / RAG System"]
    end

    subgraph PACK["📦 Pack 层 / Pack Layer — YAML 定义"]
        K1["世界设定 / Lore"]
        K2["场景模板 / Scenes"]
        K3["PC 模板 / PC Templates"]
        K4["Actor 模板 / Actor Templates"]
        K5["物品定义 / Items"]
        K6["场景对象 / SceneObjects"]
    end

    subgraph DATA["💾 数据层 / Data Layer — SQLite + ChromaDB"]
        D1["WorldStateStore (SQLite)"]
        D2["ChromaManager (记忆向量)"]
        D3["CheckpointStore (回滚)"]
    end

    UI <-->|WebSocket| API
    API --> ORCH
    ORCH --> AGENT
    ORCH --> DATA
    AGENT --> DATA
    PACK --> DATA
